#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main()
{
    int f1, f2;
    char ch;
    f1 = open("file1.txt", O_RDONLY);
    f2 = open("file2.txt", O_WRONLY | O_CREAT, 0644);
    while (read(f1, &ch, 1))
        write(f2, &ch, 1);
    close(f1);
    close(f2);
    printf("File copied successfully");
    return 0;
}
