#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
int main()
{
    int fd;
    char buffer[100];
    fd = creat("sample.txt", 0644);
    if (fd < 0)
    {
        printf("File creation failed\n");
        return 1;
    }
    printf("File created successfully\n");
    write(fd, "Hello UNIX System Calls", 23);
    close(fd);
    fd = open("sample.txt", O_RDONLY);
    read(fd, buffer, 23);
    buffer[23] = '\0';
    printf("File Content: %s\n", buffer);
    close(fd);
    return 0;
}
